# HTTP
PORT=3000

# --- SMTP probing -----------------------------------------------------------
# The only stage that can confirm a mailbox exists. Needs outbound port 25,
# which most cloud hosts block by default. See the README before deploying.
# Defaults to false when a serverless runtime (Netlify, Lambda) is detected,
# since port 25 is blocked there with no exception.
SMTP_ENABLED=true

# IMPORTANT: set both of these to real values you control.
# SMTP_HELO_HOST must resolve, and the server's reverse DNS (PTR) should match
# it. SMTP_FROM_EMAIL should be a monitored mailbox on a domain with SPF set.
# Leaving the defaults gets your probes throttled or blocklisted.
SMTP_HELO_HOST=probe.yourdomain.com
SMTP_FROM_EMAIL=verify@yourdomain.com

SMTP_PORT=25
SMTP_TIMEOUT_MS=8000
SMTP_MAX_HOSTS=2

# Probe a random local part to detect domains that accept every address.
CATCH_ALL_DETECTION=true

# --- Pacing -----------------------------------------------------------------
# Probes to one mail server are serialized and spaced out. Raising throughput
# here gets you rate-limited, which corrupts later results.
PER_HOST_DELAY_MS=1200
BULK_CONCURRENCY=5
BULK_MAX_EMAILS=1000

# --- Cache ------------------------------------------------------------------
CACHE_TTL_MS=86400000
CACHE_MAX_ENTRIES=50000

# --- Upstream delegation (serverless / Netlify) ------------------------------
# When set, the SMTP stage is delegated to another instance of this app running
# somewhere with outbound port 25 open. This is how a Netlify deployment still
# confirms real mailboxes: Netlify serves the UI and API, the upstream probes.
# Only requests that reach the SMTP stage are forwarded, and if the upstream is
# unreachable the result degrades to "unknown" rather than being invented.
# VERIFY_UPSTREAM_URL=https://probe.yourdomain.com
# VERIFY_UPSTREAM_KEY=the-API_KEY-of-that-upstream-instance
# VERIFY_UPSTREAM_TIMEOUT_MS=20000

# --- API protection ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# When set, every /api request must send a matching X-API-Key header.
# API_KEY=change-me
